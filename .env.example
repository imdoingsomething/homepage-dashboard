# Weather API (OpenWeatherMap)
WEATHER_API_KEY=your_openweather_api_key
LOCATION_LAT=your_latitude
LOCATION_LON=your_longitude
LOCATION_CITY=Your_City

# Google APIs
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_CALENDAR_CLIENT_ID=your_google_calendar_client_id
GOOGLE_CALENDAR_CLIENT_SECRET=your_google_calendar_client_secret
GOOGLE_CALENDAR_ID=your_shared_calendar_id@group.calendar.google.com
GOOGLE_CALENDAR_REDIRECT_URI=http://your-pi-ip:3000/auth/callback

# Server
PORT=3000